<Bindings>
	<Binding name="WHODIDIT_TOGGLE" header="WHODIDIT">WhoDidIt.UI:Toggle()</Binding>
	<Binding name="WHODIDIT_MARKPACK">WhoDidIt_MarkPack()</Binding>
	<Binding name="WHODIDIT_MARKNEXT">WhoDidIt_MarkNext()</Binding>
	<Binding name="WHODIDIT_SAVEMARKS">WhoDidIt_SaveMarks()</Binding>
	<Binding name="WHODIDIT_CLEARMARKS">WhoDidIt_ClearMarks()</Binding>
	<Binding name="WHODIDIT_LOOT">WhoDidIt.UI:SetMode("loot")</Binding>
	<!-- >>> RollFor bindings (generated) -->
	<Binding name="Toggle options window" header="ROLLFOR">if RollFor and RollFor.key_bindings then RollFor.key_bindings.options_toggle() end</Binding>
	<Binding name="Toggle SR import window">if RollFor and RollFor.key_bindings then RollFor.key_bindings.softres_toggle() end</Binding>
	<Binding name="Toggle winners window">if RollFor and RollFor.key_bindings then RollFor.key_bindings.winners_toggle() end</Binding>
	<!-- <<< RollFor bindings -->
</Bindings>
